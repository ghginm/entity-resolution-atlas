{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:entity-resolution-atlas:AU-v2:freeze",
  "type": "object",
  "properties": {
    "benchmark_id": {
      "const": "AU-v2"
    },
    "package_version": {
      "const": "2.0.0"
    },
    "created_at": {
      "type": "string",
      "pattern": "^2026-[0-9]{2}-[0-9]{2}T.+\\+00:00$"
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "frozen_file_count": {
      "type": "integer",
      "minimum": 1
    },
    "json_file_count": {
      "type": "integer",
      "minimum": 1
    },
    "manifest_self_excluded": {
      "const": true
    },
    "integrity_mode": {
      "const": "exclusive-create; external manifest SHA256 anchor"
    }
  },
  "required": [
    "benchmark_id",
    "package_version",
    "created_at",
    "files",
    "frozen_file_count",
    "json_file_count",
    "manifest_self_excluded",
    "integrity_mode"
  ],
  "additionalProperties": false
}
